<idea-plugin>
    <!-- Module descriptors use <dependencies><plugin id="..."/></dependencies> for external-plugin
         deps; classic <depends> tags are explicitly disallowed here (confirmed against
         https://plugins.jetbrains.com/docs/intellij/modular-plugins.html). LSP4IJ is kept for both
         LSP and DAP, rather than switching the LSP half to the native intellij.platform.lsp module
         this scaffold originally suggested, since DAP debugging has no native-platform equivalent
         at all; using one mechanism for both is simpler than mixing two, and LSP4IJ is already
         fully verified working from the single-module prototype. -->
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="flix.jetbrains.plugin.shared"/>
        <module name="flix.jetbrains.plugin.language"/>
        <plugin id="com.redhat.devtools.lsp4ij"/>
    </dependencies>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">

        <server id="flixLanguageServer"
                name="Flix Language Server"
                factoryClass="dev.wstein.flixplugin.FlixLanguageServerFactory">
            <description><![CDATA[
            The Flix "Plain-LSP" server (<code>flix lsp</code>), resolved from the open project's
            <code>flix-vendor-*.jar</code> (or <code>$FLIX_FORK_JAR</code>), the same way
            <code>scripts/flix-fork</code> does.
            ]]></description>
        </server>

        <!-- languageMapping, now that the language module registers a real Language("Flix").
             fileNamePatternMapping was used before only because there was no Language to map, and
             because it left TextMate coloration alone; both reasons are gone.

             languageId is carried across explicitly. It is not cosmetic: it is the value sent as
             `languageId` in textDocument/didOpen, and dropping the attribute changes what the
             server is told the document is. -->
        <languageMapping language="Flix"
                         serverId="flixLanguageServer"
                         languageId="flix"/>

        <!-- This second mapping (same extension point, serverId pointed at the debug adapter
             instead of the language server) is what makes "click Debug on this file" work for
             .flix files at all: DebugAdapterManager.findDebugAdapterServerFor() consults exactly
             this serverId to mappings table to recognize a file as debuggable *before* any run
             configuration exists, which is what LSP4IJ's built-in DAPRunConfigurationProvider
             (a LazyRunConfigurationProducer of DAPRunConfiguration) needs to auto-create one from
             context. Without it, .flix files were invisible to that discovery step entirely,
             confirmed by decompiling DebugAdapterManager/DebugAdapterDescriptorFactory (0.20.1
             ships no sources jar); FlixDebugAdapterDescriptorFactory#prepareConfiguration then
             fills in the resulting configuration's own Mappings tab data, which this extension
             point entry does NOT do by itself (it only makes the file discoverable, not
             debuggable once a configuration exists, see that override's javadoc). -->
        <fileNamePatternMapping patterns="*.flix"
                                serverId="flixDebugAdapter"
                                languageId="flix"/>

        <debugAdapterServer id="flixDebugAdapter"
                            name="Flix (--Xdebug attach)"
                            factoryClass="dev.wstein.flixplugin.FlixDebugAdapterDescriptorFactory">
            <description><![CDATA[
            Attaches to a Flix program started with <code>--Xdebug</code>
            (<code>JAVA_TOOL_OPTIONS=-agentlib:jdwp=...</code>), translating JDI to DAP via the
            bundled <code>FlixDebugAdapter.java</code> -- the identical adapter this project's VS
            Code extension uses, started here with its "--port" socket transport instead of stdio
            since LSP4IJ's DAP client only ever connects to a debug adapter over a socket.
            <p><b>After creating a "Flix (--Xdebug attach)" run configuration, you must add a
            <code>*.flix</code> mapping to it on the "Mappings" tab before breakpoints in .flix
            files are recognized</b> -- LSP4IJ has no plugin.xml-level file mapping for DAP servers
            (unlike its LSP languageMapping above), only this per-run-configuration UI
            step.</p>
            ]]></description>
        </debugAdapterServer>

    </extensions>

    <!-- LSP4IJ registers several of its features only for language="TEXT" and language="textmate".
         Until this plugin registered a real Language("Flix"), .flix files *were* textmate files and
         got them for free; registering our own language silently takes them away, so the ones we
         still want are re-registered here against the Flix language.

         This is a per-feature judgement, not a blanket copy of LSP4IJ's textmate block:

           - lang.fileViewProviderFactory is deliberately NOT re-registered. LSP4IJ's own comment
             calls it a view provider "for TextMate files", and the class is the *Structureless*
             one: it exists for files with no PSI. Installing it for Flix would replace the real
             file view provider and destroy the parse tree the language module just added.
             Semantic-token colouring is unaffected – LSPSemanticTokensHighlightVisitor is
             registered globally with no language attribute, so it already applies.

           - lang.foldingBuilder is NOT re-registered either: the language module contributes a
             complete syntactic FlixFoldingBuilder, and stacking a second builder over the same
             regions risks duplicate and overlapping fold handles for no gain.

           - typeHierarchyProvider and callHierarchyProvider are NOT re-registered, because
             `flix lsp` advertises neither capability (LspServer.mkServerCapabilities sets no
             typeHierarchy/callHierarchy provider). Registering them would add menu entries that
             can never resolve. Revisit if the server starts advertising them. -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- The gutter run arrow beside `def main`.
             Registered here, not in the always-loaded language module, because line markers are
             produced by the highlighting pass and resolved through ExecutorAction against
             run-configuration producers – both backend concerns under split mode. Registering it in
             a module that loads in *both* processes produced two arrows on the line: the backend
             one found the DAP producer and built the correct menu, while the frontend one had no
             producers to offer and rendered "Nothing here".
             The contributor class itself stays in the language module, which owns FlixDefDecl; the
             module dependency above makes it resolvable from here. -->
        <runLineMarkerContributor
                language="Flix"
                implementationClass="org.flixlang.intellij.run.FlixRunLineMarkerContributor"/>

        <lang.psiStructureViewFactory
                language="Flix"
                implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>

        <codeBlockProvider
                language="Flix"
                implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"/>

        <codeInsight.parameterInfo
                language="Flix"
                implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>
    </extensions>


    <!-- Registers the "flix.runMain" LSP command the Flix language server attaches to the "Run"
         CodeLens above def main(). LSP4IJ maps LSP commands to IntelliJ actions 1:1 by id (see
         docs/DeveloperGuide.md#lsp-commands); without this the CodeLens fails with "Missing
         'flix.runMain' command... needs to be contributed by an IntelliJ plugin". Registered here
         (backend) alongside everything else rather than split into frontend, since LSP4IJ itself
         is not known to be split-mode-modularized; unverified assumption, revisit if the CodeLens
         click doesn't dispatch correctly under split mode. -->
    <actions>
        <action id="flix.runMain"
                class="dev.wstein.flixplugin.FlixRunMainAction"
                text="Flix: Run Main"
                description="Runs `flix run` for the project (bound to the Flix language server's &quot;Run&quot; CodeLens above def main())"/>
    </actions>
</idea-plugin>
