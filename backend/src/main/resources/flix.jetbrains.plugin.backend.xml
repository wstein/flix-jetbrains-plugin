<idea-plugin>
    <!-- Module descriptors use <dependencies><plugin id="..."/></dependencies> for external-plugin
         deps; classic <depends> tags are explicitly disallowed here (confirmed against
         https://plugins.jetbrains.com/docs/intellij/modular-plugins.html). LSP4IJ is the LSP client, rather
         than the native intellij.platform.lsp module this scaffold originally suggested, and is
         fully verified working. It once also served DAP; that path was retired in favour of
         IntelliJ's own JVM debugger (ADR 0002), so only the LSP half remains. -->
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="flix.jetbrains.plugin.shared"/>
        <module name="flix.jetbrains.plugin.language"/>
        <plugin id="com.redhat.devtools.lsp4ij"/>
    </dependencies>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">

        <server id="flixLanguageServer"
                name="Flix Language Server"
                factoryClass="dev.wstein.flixplugin.FlixLanguageServerFactory">
            <description><![CDATA[
            The Flix "Plain-LSP" server (<code>flix lsp</code>), resolved from the open project's
            <code>flix.jar</code> (or <code>$FLIX_JAR</code>).
            ]]></description>
        </server>

        <!-- languageMapping, now that the language module registers a real Language("Flix").
             fileNamePatternMapping was used before only because there was no Language to map, and
             because it left TextMate coloration alone; both reasons are gone.

             languageId is carried across explicitly. It is not cosmetic: it is the value sent as
             `languageId` in textDocument/didOpen, and dropping the attribute changes what the
             server is told the document is. -->
        <languageMapping language="Flix"
                         serverId="flixLanguageServer"
                         languageId="flix"/>
    </extensions>

    <!-- LSP4IJ registers several of its features only for language="TEXT" and language="textmate".
         Until this plugin registered a real Language("Flix"), .flix files *were* textmate files and
         got them for free; registering our own language silently takes them away, so the ones we
         still want are re-registered here against the Flix language.

         This is a per-feature judgement, not a blanket copy of LSP4IJ's textmate block:

           - lang.fileViewProviderFactory is deliberately NOT re-registered. LSP4IJ's own comment
             calls it a view provider "for TextMate files", and the class is the *Structureless*
             one: it exists for files with no PSI. Installing it for Flix would replace the real
             file view provider and destroy the parse tree the language module just added.
             Semantic-token colouring is unaffected – LSPSemanticTokensHighlightVisitor is
             registered globally with no language attribute, so it already applies.

           - lang.foldingBuilder is NOT re-registered either: the language module contributes a
             complete syntactic FlixFoldingBuilder, and stacking a second builder over the same
             regions risks duplicate and overlapping fold handles for no gain.

           - typeHierarchyProvider and callHierarchyProvider are NOT re-registered, because
             `flix lsp` advertises neither capability (LspServer.mkServerCapabilities sets no
             typeHierarchy/callHierarchy provider). Registering them would add menu entries that
             can never resolve. Revisit if the server starts advertising them. -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- The gutter run arrow beside `def main`.
             Registered here, not in the always-loaded language module, because line markers are
             produced by the highlighting pass and resolved through ExecutorAction against
             run-configuration producers – both backend concerns under split mode. Registering it in
             a module that loads in *both* processes produced two arrows on the line: the backend
             one found the run-configuration producer (then the DAP one, since removed) and built
             the correct menu, while the frontend one had no
             producers to offer and rendered "Nothing here".
             The contributor class itself stays in the language module, which owns FlixDefDecl; the
             module dependency above makes it resolvable from here. -->
        <runLineMarkerContributor
                language="Flix"
                implementationClass="org.flixlang.intellij.run.FlixRunLineMarkerContributor"/>

        <lang.psiStructureViewFactory
                language="Flix"
                implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>

        <codeBlockProvider
                language="Flix"
                implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"/>

        <codeInsight.parameterInfo
                language="Flix"
                implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>
    </extensions>


    <!-- Registers the "flix.runMain" LSP command the Flix language server attaches to the "Run"
         CodeLens above an entry point. The id is the server's; the action is not limited to `main`,
         and honours the entry-point symbol the command carries.
         LSP4IJ maps LSP commands to IntelliJ actions 1:1 by id (see
         docs/DeveloperGuide.md#lsp-commands); without this the CodeLens fails with "Missing
         'flix.runMain' command... needs to be contributed by an IntelliJ plugin". Registered here
         (backend) alongside everything else rather than split into frontend. That was recorded as
         an unverified assumption and is now checked: LSP4IJ's plugin.xml declares no content
         modules, so it is monolithic and runs host-side under split mode, as does anything calling
         it. -->
    <!-- The diagram view and the action that fills it. Both are here rather than in frontend for
         the reason above: the action drives LSP4IJ, so it runs host-side, and a tool window
         registered beside it is proxied to the client exactly as LSP4IJ's own UI is.

         The action id is deliberately NOT the LSP command name. LSP4IJ resolves a command
         server-side first and only falls back to an IntelliJ action of the same id, so naming this
         `flix.showDiagram` would risk the action invoking the command that invokes the action. -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- `order="first"` so this is asked before LSP4IJ's own renameHandler, which is registered
             `first` too and always opens a modal dialog: it has no in-place mode to configure.
             This one edits every occurrence in the open file at once and hands back to LSP4IJ's
             dialog for anything it cannot serve, so nothing is lost by being asked first. -->
        <renameHandler id="FlixInplaceRenameHandler" order="first"
                       implementation="dev.wstein.flixplugin.ui.FlixInplaceRenameHandler"/>

        <toolWindow id="Flix Diagrams"
                    anchor="right"
                    icon="com.intellij.icons.AllIcons.Toolwindows.ToolWindowPalette"
                    factoryClass="dev.wstein.flixplugin.ui.FlixDiagramToolWindowFactory"/>

        <!-- Where a problem with the project's own configuration is reported. The one message that
             uses it today is "no compiler could be resolved", which is why the language server was
             not started; it used to reach the user as a stack trace out of the syntax highlighter,
             once per highlighting pass, because that is where the failed start happened to be
             triggered from. A balloon is where a message about a project belongs.

             The group must be registered: an unregistered id is dropped with a log line, which
             would put the message nowhere at all. -->
        <notificationGroup id="Flix" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="Flix.ShowDiagram"
                class="dev.wstein.flixplugin.ui.FlixShowDiagramAction"
                text="Show Flix Diagram"
                description="Renders the structure of the trait or module at the caret in the Flix Diagrams tool window">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!-- Recompiles with phase printing on and opens what the compiler wrote. Backend, because
             it goes to the language server; in Tools > Flix beside the tasks, because that is where
             a whole-project action belongs rather than in the editor's context menu. -->
        <action id="Flix.ShowAst"
                class="dev.wstein.flixplugin.ui.FlixShowAstAction"
                text="Show AST"
                description="Recompile with phase printing on and open the ASTs the compiler writes">
            <add-to-group group-id="Flix.Tasks" anchor="last"/>
        </action>

        <action id="flix.runMain"
                class="dev.wstein.flixplugin.FlixRunMainAction"
                text="Flix: Run Entry Point"
                description="Runs the entry point the &quot;Run&quot; CodeLens sits above, via `flix run --entrypoint`; falls back to the project default when the server sends no symbol"/>
    </actions>
</idea-plugin>
