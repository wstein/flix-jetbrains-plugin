<idea-plugin>
    <!-- Flix support for IntelliJ's own JVM debugger (docs/adr/0002-native-jvm-debugger.md).

         Scoped to the backend. Both extensions below are consumed by the Java debug process:
         DebugProcessImpl builds its CompoundPositionManager from positionManagerFactory, and
         DebuggerUtils.isBreakpointAware consults javaDebugAware when deciding whether a line can
         take a breakpoint. Under split mode that runs backend-side, so loading this module on the
         frontend would register extensions nothing there will ever ask for.

         The Java plugin dependency is scoped here for the same reason this is a separate module at
         all: com.intellij.debugger.PositionManagerFactory lives in the Java plugin, and the
         language layer has to keep loading in IDEs without one. The module is therefore NOT
         loading="required" – if the Java plugin is absent it is skipped and the rest of the plugin
         still works. -->
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="flix.jetbrains.plugin.language"/>
        <module name="flix.jetbrains.plugin.shared"/>
        <plugin id="com.intellij.java"/>

        <!-- The Java plugin's own content modules, which the plugin dependency above does NOT bring
             with it. Each has a classloader of its own, and a module that has not asked for one
             cannot see its classes: com.intellij.execution.configurations.RemoteConnection lives
             in intellij.java.execution, and without this line a Debug launch died with
             NoClassDefFoundError at the first line of FlixLaunch that mentions it. It reproduced
             only in an installed 2026.2 IDE: the Plugin Verifier reports the plugin compatible,
             because the class *is* in the distribution, and the sandbox resolved it too.

             The debugger modules are listed for the same reason even though they happen to
             resolve today: nothing about them differs from the one that did not. -->
        <module name="intellij.java.execution"/>
        <module name="intellij.java.debugger"/>
        <module name="intellij.java.debugger.impl"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Makes the *stock* Java line breakpoint accept .flix lines. Without it,
             JavaLineBreakpointTypeBase.canPutAtElement refuses the file outright and the position
             manager below is never consulted, because nothing asks it to resolve anything. -->
        <debugger.javaDebugAware
                implementation="dev.wstein.flixplugin.debugger.FlixJavaDebugAware"/>

        <debugger.positionManagerFactory
                implementation="dev.wstein.flixplugin.debugger.FlixPositionManagerFactory"/>

        <!-- Where a step may stop, which the position manager has no say in. Flix's CPS output puts
             one source line in each continuation frame and none at all in the generated invoke()
             bridges, so Java's "run until the line changes in this frame" always ends on frame pop,
             in bytecode with no source. This carries the step on to the next Flix line. Scoped to
             Flix's own frames, so Java, Kotlin and Scala stepping is untouched. -->
        <debugger.extraSteppingFilter
                implementation="dev.wstein.flixplugin.debugger.FlixSteppingFilter"/>

        <!-- Carries the Step Over / Step Into distinction into the step. CPS invokes every
             continuation from one trampoline loop, so successive Flix lines sit at the same JVM
             depth and the difference is no longer readable from the stack once stepping starts.
             beforeSteppingStarted is the one point that knows both the chosen action and the
             position it was chosen from. -->
        <debugger.jvmSteppingCommandProvider
                implementation="dev.wstein.flixplugin.debugger.FlixSteppingCommands"/>

        <!-- The canonical Flix run/debug configuration (ADR 0002, plan Phase 4). Registered here
             rather than in the backend module because Debug attaches IntelliJ's own Java debugger,
             which lives in the Java plugin. One type covers Run and Debug: they differ only in the
             compiler invocation and whether a JDWP agent is attached. -->
        <configurationType
                implementation="dev.wstein.flixplugin.run.FlixRunConfigurationType"/>

        <!-- Turns a `def` in the editor into that configuration, which is what the gutter arrow and
             the context menu act on. Scoped to .flix files. -->
        <runConfigurationProducer
                implementation="dev.wstein.flixplugin.run.FlixRunConfigurationProducer"/>

        <!-- Debug, sequenced. A debug launch is two phases – a debug build, then the program JVM
             the agent is on – and everything that reaches startProcess is on the EDT, where a build
             that takes minutes is a freeze and a logged error. This runner does phase one on a
             background thread and then hands the launch back to the platform's debugger runner.

             order="first" is load-bearing: GenericDebuggerRunner.canRun accepts this configuration
             too, since it asks only for ModuleRunProfile, and the platform takes the first runner
             that answers. Losing that race puts the build back on the EDT with nothing to say so.

             (Written with en dashes: an XML comment may not contain a double hyphen, and one here
             stopped the whole plugin from loading once.) -->
        <programRunner
                order="first"
                implementation="dev.wstein.flixplugin.run.FlixDebuggerRunner"/>

        <!-- Flix values carry their shape in a form the Java debugger cannot read: a record is a
             linked list of label/value/rest nodes, and a tagged union is a class whose name ends in
             the tag. Unrendered they show as {RecordExtend$Obj@1234}, which says nothing. Both are
             registered against the shared supertype, so every specialisation is covered without
             naming it. Value$ is deliberately not rendered: it is a union struct with nine fields
             and no discriminator, so no reader could say which one is live. -->
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixRecordRenderer"/>
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixTaggedRenderer"/>

        <!-- A tuple is the one Flix value whose compiled class says everything about it: each arity
             and component typing gets a class of its own, `Tuple$Int32$Int32`, with `field0` and
             `field1`. Unrendered it shows as {Tuple$Int32$Int32@3405}, which names the shape and
             not the value; the language writes a tuple as (1, 2) and so does this. -->
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixTupleRenderer"/>

        <!-- A struct's class is shared by every struct of the same erased shape and names its
             fields by position, so it says how many there are and nothing else: a channel read as
             field0 through field5. An Xdebug build records the struct's name and its field names in
             the value, and this pairs them up. -->
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixStructRenderer"/>

        <!-- A function value and a lazy one. A lifted lambda is a class named after the definition
             it came out of, holding its captures in clo0, clo1 and its calling state in pc and
             arg0; the captures are the value and the rest is machinery. A lazy value keeps its
             unevaluated expression until it is forced, and clears it then, so which of the two it
             is can be read without running anything. -->
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixClosureRenderer"/>
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixLazyRenderer"/>

        <!-- An anonymous object. Its own class name is an id, so what identifies it is the Java
             type it implements and the methods it defines; each method's body is the closure held
             beside it, which renders as itself. -->
        <debugger.compoundRendererProvider
                implementation="dev.wstein.flixplugin.debugger.FlixAnonymousRenderer"/>

        <!-- Lets a watch be written in Flix rather than in Java. IntelliJ's Java debugger still owns
             the session (ADR 0002); this only supplies the front end for a .flix context, so Java,
             Kotlin and Scala frames keep their own evaluators: `isContextAccepted` is what keeps
             them apart, and the platform asks every factory.

             The Kotlin plugin registers against this same point for its own frames, which is what
             establishes that it is reached at all: a Kotlin frame is a plain JavaStackFrame, exactly
             as a Flix one is.

             Deliberately not a translation of Flix into Java. It answers only what can be read from
             the paused frame (a name, and record projections out of it) and refuses everything
             else by naming the limit. Anything larger has to be resolved, typed and lowered by the
             compiler and run in the debuggee. -->
        <debugger.codeFragmentFactory
                implementation="dev.wstein.flixplugin.debugger.FlixCodeFragmentFactory"/>

        <!-- The Flix call chain, which the JVM stack does not contain. Under CPS the trampoline
             invokes every continuation from one loop, so one Flix frame is live at a time and the
             calls the programmer made live in continuation objects on the heap. Measured on a real
             stop: 36 JVM frames for a chain of four Flix calls, 35 of them hidden and every one of
             them handler machinery.

             The same extension point Kotlin uses to show a coroutine's logical stack rather than
             its dispatcher. The platform draws the result under an "Async stack trace" separator,
             and JavaExecutionStack schedules it with a null frame iterator, so what is returned
             *replaces* the real frames below the one answered for rather than following them. That
             is why this answers only for the topmost frame, and only when it is Flix: the platform
             asks every provider about every frame of every JVM language. -->
        <debugger.asyncStackTraceProvider
                implementation="dev.wstein.flixplugin.debugger.FlixAsyncStackTraceProvider"/>
    </extensions>
</idea-plugin>
