<idea-plugin>
    <!-- No frontend-specific extensions yet: everything (LSP4IJ server/DAP registration, TextMate
         bundle, flix.runMain action) currently lives in the backend module; see
         backend/src/main/resources/flix.jetbrains.plugin.backend.xml for why. This module is a
         placeholder for future genuinely frontend-only UI (e.g. a Datalog proof-tree tool window). -->
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="flix.jetbrains.plugin.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Flix Diagrams"
                    anchor="right"
                    icon="com.intellij.icons.AllIcons.Toolwindows.ToolWindowPalette"
                    factoryClass="dev.wstein.flixplugin.ui.FlixDiagramToolWindowFactory"/>
    </extensions>
</idea-plugin>
