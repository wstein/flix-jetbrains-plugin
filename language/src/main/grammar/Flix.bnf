/*
 * Grammar-Kit BNF grammar for the Flix programming language.
 *
 * This grammar is a faithful, from-scratch re-derivation of the authoritative hand-written
 * Scala parser at:
 *   flix/main/src/ca/uwaterloo/flix/language/phase/Parser2.scala
 * cross-referenced against the syntax-node inventory at:
 *   flix/main/src/ca/uwaterloo/flix/language/ast/SyntaxTree.scala (sealed trait TreeKind)
 * and the token set at:
 *   intellij-flix/src/main/grammar/Flix.tokens.txt  (158 tokens, hand-lexed by _Flix.flex)
 *
 * ---------------------------------------------------------------------------------------------
 * DELIBERATE SIMPLIFICATIONS (see final report for the complete list). Each is also called out
 * with a short inline comment at the relevant rule:
 *
 *   1. Comments (COMMENT_LINE / COMMENT_DOC / COMMENT_BLOCK) and whitespace are not referenced
 *      anywhere in this grammar. Unlike the Scala parser (which threads doc-comments through the
 *      tree as explicit TreeKind.Doc/CommentList nodes so later phases can re-attach them), an
 *      IntelliJ Grammar-Kit grammar instead treats comment/whitespace tokens as parser trivia
 *      that the PsiBuilder attaches to the tree automatically (via ParserDefinition's whitespace
 *      / comment token sets, configured outside this file). This is the standard, idiomatic
 *      approach for Grammar-Kit grammars (see e.g. the Rust/Kotlin/TOML plugins).
 *   2. Both "->" spellings (ARROW_THIN_R, the whitespace-sensitive variant, and
 *      ARROW_THIN_R_TIGHT) are accepted interchangeably everywhere an arrow is expected (the
 *      `arrow` helper rule below), per the task's explicit guidance -- the whitespace-sensitivity
 *      that distinguishes them is a lexer concern, not a grammar-structural one.
 *   3. Qualified/simple name *token-kind-set* precision (e.g. "only uppercase names are legal
 *      tags", "only lowercase names are legal record fields") is not enforced structurally.
 *      Every name position uses one of a small number of general `ident`/`qualifiedName` helper
 *      rules. The reference parser tracks ~15 distinct legal-token-kind sets per name position
 *      (NAME_VARIABLE, NAME_FIELD, NAME_TAG, NAME_TYPE, NAME_EFFECT, ...); reproducing all of
 *      those distinctly in a CFG would multiply the rule count several-fold for no benefit to a
 *      PSI-based IDE grammar -- that lexical-class validation belongs in a semantic annotator.
 *   4. Statement-level implicit-semicolon-insertion / missing-operator error recovery (the
 *      `notBinaryOperator` / `canFollowBinaryOperator` heuristics in Expr.statement()) is not
 *      modeled; `statement` is simply `expr (SEMI expr)*`.
 *   5. Unary prefix operators (discard/lazy/force/not/unary +-) are modeled as their own
 *      precedence-chain levels bottoming out in `postfixExpr`. The reference parser's operand
 *      for a unary prefix op is a fully general, precedence-bounded `expression(leftOpt=...)`
 *      call, which (due to an implementation quirk) lets the *enclosing* call's postfix loop
 *      re-apply postfix operators (call/field/index) on top of an already-unary-wrapped result.
 *      This grammar applies postfix operators only directly to atoms (the conventional,
 *      standard placement), not on top of unary expressions.
 *   6. Extensible-variant *patterns* (`TreeKind.Pattern.ExtTag`) are not modeled as a separate
 *      pattern form: Parser2.scala's `Pattern.pattern()` dispatch table has no case building
 *      that tree kind (only `Expr.extTagExpr` / `Expr.extMatchExpr` construct extensible-variant
 *      *expressions*), so ordinary tag patterns are used to cover this position too.
 *   7. A handful of very rare defensive/fallback shapes in the reference parser (e.g. the
 *      `(ParenL, ParenR) => expression()` unit-shorthand branch inside fixpointQuerySelect, which
 *      is subsumed by `expr` already handling parenthesized/unit expressions generally) are
 *      collapsed into their more general sibling production.
 *   8. No `pin`/`recoverWhile` error-recovery attributes are used anywhere (conservative, per
 *      task guidance): this is a purely structural grammar, correctness-first.
 * ---------------------------------------------------------------------------------------------
 */
{
  parserClass="org.flixlang.intellij.lang.parser.FlixParser"
  // Only needed for `traitMemberError`'s `<<consumeUntilTraitMemberStart>>` external rule below --
  // extends GeneratedParserUtilBase itself, so every other generated call (recursion_guard_,
  // consumeToken, report_error_, ...) still resolves through the same `import static X.*` exactly
  // as it did with the implicit default. See FlixParserUtil.kt's own class comment for why this
  // exists: a declarative Grammar-Kit rule can't express "consume any token, of whichever kind,
  // repeatedly", which Parser2.scala's own hand-written trait-body recovery loop needs.
  parserUtilClass="org.flixlang.intellij.lang.parser.FlixParserUtil"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Flix"
  psiImplClassSuffix="Impl"
  psiPackage="org.flixlang.intellij.lang.psi"
  psiImplPackage="org.flixlang.intellij.lang.psi.impl"

  elementTypeHolderClass="org.flixlang.intellij.lang.psi.FlixTypes"
  elementTypeClass="org.flixlang.intellij.lang.psi.FlixElementType"
  tokenTypeClass="org.flixlang.intellij.lang.psi.FlixTokenType"

  tokens = [
      // ===== Keywords (79) =====
      ALIAS_KW='alias'
      AND_KW='and'
      AS_KW='as'
      CASE_KW='case'
      CATCH_KW='catch'
      CHECKED_CAST_KW='checked_cast'
      CHECKED_ECAST_KW='checked_ecast'
      CHOOSE_KW='choose'
      CHOOSE_STAR_KW='choose*'
      DEF_KW='def'
      DISCARD_KW='discard'
      EFF_KW='eff'
      ELSE_KW='else'
      EMATCH_KW='ematch'
      ENUM_KW='enum'
      FALSE_KW='false'
      FIX_KW='fix'
      FORA_KW='forA'
      FORM_KW='forM'
      FORALL_KW='forall'
      FORCE_KW='force'
      FOREACH_KW='foreach'
      FROM_KW='from'
      HANDLER_KW='handler'
      IF_KW='if'
      IMPORT_KW='import'
      INJECT_KW='inject'
      INSTANCE_KW='instance'
      INSTANCEOF_KW='instanceof'
      INTO_KW='into'
      LAW_KW='law'
      LAWFUL_KW='lawful'
      LAZY_KW='lazy'
      LET_KW='let'
      MATCH_KW='match'
      MOD_KW='mod'
      MUT_KW='mut'
      NEW_KW='new'
      NOT_KW='not'
      NULL_KW='null'
      OPEN_VARIANT_KW='open_variant'
      OPEN_VARIANT_AS_KW='open_variant_as'
      OR_KW='or'
      PQUERY_KW='pquery'
      PSOLVE_KW='psolve'
      PAR_KW='par'
      PROJECT_KW='project'
      PUB_KW='pub'
      QUERY_KW='query'
      REDEF_KW='redef'
      REGION_KW='region'
      RESTRICTABLE_KW='restrictable'
      RUN_KW='run'
      RVADD_KW='rvadd'
      RVAND_KW='rvand'
      RVNOT_KW='rvnot'
      RVSUB_KW='rvsub'
      SEALED_KW='sealed'
      SELECT_KW='select'
      SOLVE_KW='solve'
      SPAWN_KW='spawn'
      STATIC_KW='static'
      STATIC_UPPER_KW='Static'
      STRUCT_KW='struct'
      SUPER_KW='super'
      THROW_KW='throw'
      TRAIT_KW='trait'
      TRUE_KW='true'
      TRY_KW='try'
      TYPE_KW='type'
      UNCHECKED_CAST_KW='unchecked_cast'
      UNIV_KW='Univ'
      UNSAFE_KW='unsafe'
      USE_KW='use'
      WHERE_KW='where'
      WITH_KW='with'
      XOR_KW='xor'
      XVAR_KW='xvar'
      YIELD_KW='yield'

      // ===== Prefixed-hash collection literals (5) =====
      ARRAY_HASH='Array#'
      LIST_HASH='List#'
      MAP_HASH='Map#'
      SET_HASH='Set#'
      VECTOR_HASH='Vector#'

      // ===== Simple tokens / delimiters (17) =====
      HASH='#'
      HASH_PAREN_L='#('
      HASH_CURLY_L='#{'
      HASH_BAR='#|'
      PAREN_L='('
      PAREN_R=')'
      COMMA=','
      SEMI=';'
      HOLE_ANONYMOUS='???'
      BRACKET_L='['
      BACKSLASH='\'
      BRACKET_R=']'
      TICK='`'
      CURLY_L='{'
      BAR_HASH='|#'
      CURLY_R='}'
      TILDE='~'

      // ===== Operators (23) =====
      BANG='!'
      BANG_EQUAL='!='
      AMPERSAND='&'
      STAR='*'
      PLUS='+'
      MINUS='-'
      COLON=':'
      COLON_MINUS=':-'
      COLON_COLON='::'
      COLON_COLON_COLON=':::'
      ANGLE_L='<'
      ANGLED_PLUS='<+>'
      ARROW_THIN_L='<-'
      ANGLE_L_EQUAL='<='
      ANGLED_EQUAL='<=>'
      EQUAL='='
      EQUAL_EQUAL='=='
      ARROW_THICK_R='=>'
      ANGLE_R='>'
      ANGLE_R_EQUAL='>='
      CARET='^'
      BAR='|'
      SLASH='/'

      // ===== Arrow "->" disambiguation (2) -- both spelled "->", see notes above =====
      ARROW_THIN_R_TIGHT='->'
      ARROW_THIN_R='->'

      // ===== Dot (2) =====
      DOT='.'
      DOT_WHITESPACE='.'

      // ===== Misc special-cased single characters / prefixes (7) =====
      AT='@'
      ANNOTATION='annotation'
      DOLLAR='$'
      BUILT_IN='built-in'
      DEBUG_INTERPOLATOR='d'
      GENERIC_OPERATOR='operator'
      UNDERSCORE='_'

      // ===== Holes (2 remaining; HOLE_ANONYMOUS declared above) =====
      HOLE_NAMED='named hole'
      HOLE_VARIABLE='variable hole'

      // ===== Names (3) =====
      NAME_LOWERCASE='identifier'
      NAME_UPPERCASE='identifier'
      NAME_MATH='math identifier'

      // ===== Number literals (10) =====
      LITERAL_INT='int literal'
      LITERAL_INT8='int8 literal'
      LITERAL_INT16='int16 literal'
      LITERAL_INT32='int32 literal'
      LITERAL_INT64='int64 literal'
      LITERAL_BIGINT='bigint literal'
      LITERAL_FLOAT='float literal'
      LITERAL_FLOAT32='float32 literal'
      LITERAL_FLOAT64='float64 literal'
      LITERAL_BIGDECIMAL='bigdecimal literal'

      // ===== Other literals (5) =====
      LITERAL_CHAR='char literal'
      LITERAL_STRING='string literal'
      LITERAL_REGEX='regex literal'
      LITERAL_STRING_INTERPOLATION_L='string interpolation start'
      LITERAL_STRING_INTERPOLATION_R='string interpolation end'

      // ===== Comments (3) -- never referenced in rule bodies, see note above =====
      COMMENT_LINE='line comment'
      COMMENT_DOC='doc comment'
      COMMENT_BLOCK='block comment'
  ]
}

// =================================================================================================
// ROOT
// =================================================================================================

root ::= usesOrImports declaration*

usesOrImports ::= (useDecl | importDecl)*

useDecl ::= USE_KW qualifiedName (DOT (useMany | ident))?
useMany ::= CURLY_L (aliasedName (COMMA aliasedName)* COMMA?)? CURLY_R

importDecl ::= IMPORT_KW qualifiedName (DOT (importMany | ident))?
importMany ::= CURLY_L (aliasedName (COMMA aliasedName)* COMMA?)? CURLY_R

private aliasedName ::= ident (ARROW_THICK_R ident)?

// =================================================================================================
// NAMES
// =================================================================================================

// Simplification #3 (see header): a single general identifier/qualified-name family is used at
// every name position rather than reproducing every one of the reference parser's ~15 distinct
// legal-token-kind sets (NAME_VARIABLE, NAME_FIELD, NAME_TAG, NAME_TYPE, ...).
// QUERY_KW is deliberately NOT included here: the reference parser only accepts it as an
// identifier in variable-*pattern* position (Parser2.scala's variablePat(), matching "query" as
// a binding name in `case query => ...`), never in general expression/type/qualified-name
// position. Since this collapsed `ident` rule is shared by every name position (simplification
// #3 above), including it here would make the far more common `query <db> select ... from ...`
// expression unparseable -- losing pattern-position support for the literal name "query" is a
// much smaller gap than that.
// Not `private`: the reference compiler wraps every identifier in its own AST node (`Ident`), so
// this rule must produce a real composite PSI element too, not inline its matched token directly
// into whatever rule references it. Confirmed via flix-spec's conformance suite -- a `private`
// `ident` was the single largest source of tree-shape divergence from the reference, touching
// nearly every declaration, parameter, and case name (see flix-spec's docs/CONFORMANCE.md, "a
// permanent structural gap, not a map bug", and FlixSpecConformanceTest.kt's DIVERGENCE_BASELINE).
ident ::= NAME_LOWERCASE | NAME_UPPERCASE | NAME_MATH | UNDERSCORE | GENERIC_OPERATOR | STATIC_UPPER_KW

// A trailing `.` with nothing after it lexes as DOT_WHITESPACE, not DOT (see _Flix.flex's
// `"." / {WHITE_SPACE_CHAR}` rule): the lexer itself disambiguates "dot immediately followed by
// more qname" (plain DOT, e.g. `Foo.bar`, `Foo.{bar}`) from "dangling dot" (DOT_WHITESPACE) by
// whether whitespace/EOF follows. Parser2.scala's nameAllowQualified treats DotWhiteSpace as an
// unconditional dangling-trailing-dot error case -- wrapped in its own TreeKind.TrailingDot node
// nested inside the QName, regardless of the allowTrailingDot flag that governs plain DOT (used
// by e.g. `use`/`import` to leave a real continuation dot for their own `.{...}` handling). Safe
// to fold into the shared rule below: DOT_WHITESPACE cannot appear in any of qualifiedName's
// other call sites' valid continuations, since none of them tolerate whitespace before the dot.
trailingDot ::= DOT_WHITESPACE

qualifiedName ::= ident (DOT ident)* trailingDot?

// =================================================================================================
// DECLARATIONS
// =================================================================================================

// Error recovery at the declaration boundary.
//
// Without `recoverWhile`, a single syntax error consumes the remainder of the file: the whole tail
// becomes one PsiErrorElement, so no later declaration exists as PSI, the gutter marker disappears,
// folding stops and structure view empties. Complete files are unaffected -- which is exactly why a
// corpus of compilable sources reported the grammar as green while half-written code, the normal
// state of a file being edited, degraded badly.
//
// `pin=3` commits the rule once the declaration keyword itself has matched, so the error is
// reported at the offending token rather than rejecting the whole declaration; recovery then skips
// ahead to the next token that can begin a declaration and resumes there.
declaration ::= annotationList modifierList declarationBody {pin=3 recoverWhile=declarationRecover}

// Stops as soon as something that could start the next declaration is in sight. CURLY_R is
// included so recovery inside a `mod`/`trait`/`instance` body stops at the body's closing brace
// instead of eating it and unbalancing everything after.
private declarationRecover ::= !declarationStart
private declarationStart ::=
    MOD_KW | TRAIT_KW | INSTANCE_KW | DEF_KW | REDEF_KW | LAW_KW | ENUM_KW | STRUCT_KW
  | TYPE_KW | EFF_KW | RESTRICTABLE_KW
  | PUB_KW | SEALED_KW | LAWFUL_KW | MUT_KW
  | ANNOTATION | COMMENT_DOC
  | USE_KW | IMPORT_KW
  | CURLY_R

private declarationBody ::=
    moduleDecl
  | traitDecl
  | instanceDecl
  | defDecl
  | enumDecl
  | structDecl
  | typeAliasDecl
  | effectDecl

moduleDecl ::= MOD_KW qualifiedName CURLY_L usesOrImports declaration* CURLY_R

traitDecl ::= TRAIT_KW ident typeParameterList? typeConstraints? traitBody?
// `{pin=1}` on the second alternative only: once CURLY_L is seen, commit -- without this,
// `traitMember*` matching zero iterations (because the first member's own name is malformed and
// its containing rule has no pin of its own, so it backtracks past even its leading DEF_KW/
// LAW_KW/TYPE_KW, undoing everything) leaves the whole `(CURLY_L traitMember* CURLY_R)?` group
// requiring CURLY_R immediately after CURLY_L, which fails and rolls back CURLY_L itself too --
// unlike `block`'s own pin attempt (reverted above), there's no sibling alternative here that
// legitimately needs `traitBody` to fail and backtrack (a trait's body is never ambiguous with
// anything else the way `{...}` is between block and record), so this one is safe on that count.
// (Grammar-Kit's pin is rule-level, not alternative-level -- `private traitBody` exists so the
// pin has a rule of its own to attach to, the same reason `blockWithStatement` exists.)
private traitBody ::= CURLY_L traitMember* CURLY_R {pin=1}

// Fallback for a trait member that starts with neither LAW_KW/DEF_KW/TYPE_KW nor a modifier
// (e.g. a member name that's an operator token, `<=>`, which lexes as ANGLED_EQUAL and can't
// begin *anything* recognized here): mirrors Parser2.traitDecl's own hand-written recovery
// (`while (!nth(0).isFirstInTraitDecl && !eat(CurlyR) && !eof()) advance()`), which a declarative
// rule can't express directly -- see FlixParserUtil.kt's own comment on why this needs an
// external rule rather than an enumerated token set. `consumeUntilTraitMemberStart` stops
// (without consuming) at anything that could start the next member, letting `traitMember*`'s own
// next iteration pick up from there, or consumes CURLY_R if that's what it hits (the trait body's
// own closing brace, folded into this recovery the same way the reference does).
traitMemberError ::= <<consumeUntilTraitMemberStart>>
traitMember ::= annotationList modifierList (lawDecl | signatureDecl | associatedTypeSigDecl | traitMemberError)

instanceDecl ::= INSTANCE_KW qualifiedName BRACKET_L type BRACKET_R typeConstraints? equalityConstraintList? (CURLY_L instanceMember* CURLY_R)?
instanceMember ::= annotationList modifierList (defDecl | redefDecl | associatedTypeDefDecl)

// A trait signature name that's neither a valid ident token nor a keyword at all (e.g. `<=>`,
// which the lexer tokenizes as the relational operator ANGLED_EQUAL, not any name-shaped token --
// unlike jvmMethod's RUN_KW case above, this isn't even in `ident`'s reach or a recognizable
// keyword) is Parser2.expectAny's own fallback for exactly this: when the current token matches
// neither the expected kind set nor NAME_LIKE, produce a genuinely empty (zero-width, no tokens
// consumed) ErrorTree in its place and move on -- unlike every other ErrorTree-producing fallback
// on this branch, which always consumes at least the one bad token, this one consumes literally
// nothing, leaving the same bad token for parameterList's own attempt right after, which fails
// the exact same way, and so on through colon and the return type. Each of the four positions
// below (name, parameter list, colon, return type) gets its own zero-width fallback, verified via
// PSI dump against flix-spec's own reference tree for exactly this shape before trusting the full
// suite -- Ident[ErrorTree] and Type.Type[ErrorTree] (an empty ErrorTree nested one level in,
// reusing the position's normal wrapper) for the name and return-type positions, a bare
// (unwrapped) ErrorTree for the colon position, matching Parser2.expect's own fallback exactly.
// Not just a nicety: without these, signatureDecl backtracks *entirely* on a malformed name
// (undoing even its own leading DEF_KW), which then defeats `traitMemberError`'s own recovery --
// DEF_KW ends up back at the front of the input, and `traitMemberError` correctly refuses to skip
// it (it's a perfectly legitimate trait-member start), so neither can make progress. These four
// fallbacks are what let signatureDecl actually commit past DEF_KW instead of round-tripping.
private signatureNameErrorInner ::=
signatureNameError ::= signatureNameErrorInner
private signatureParameterListErrorInner ::=
signatureParameterListError ::= signatureParameterListErrorInner
signatureColonError ::=
private signatureTypeErrorInner ::=
signatureTypeError ::= signatureTypeErrorInner
signatureDecl ::=
    DEF_KW (ident | signatureNameError) typeParameterList?
    (parameterList | signatureParameterListError)
    (COLON | signatureColonError)
    (typeAndEffect | signatureTypeError)
    typeConstraints? equalityConstraintList? (EQUAL statement)?

// `pin=9` commits once `EQUAL` (the 9th element) has matched, so a body that fails to parse at
// all -- e.g. an unterminated char/string/regex literal, whose lexeme doesn't start any known
// expr alternative -- doesn't fail `defDecl` as a whole. Without this, `declaration`'s own
// `pin=3` (see above) doesn't help: it only protects declarationBody's *own* three children from
// vanishing, not a total failure many levels down inside `statement`'s own descent, which
// backtracks defDecl -> declarationBody -> declaration in full, producing one bare top-level
// ErrorTree instead of a Decl.Def with just its body slot broken (confirmed against
// flix-spec's own reference tree for e.g. lexical__unterminated-char.flix, which keeps every
// other Decl.Def child intact and only wraps the body's ErrorTree).
defDecl ::= DEF_KW ident typeParameterList? parameterList COLON typeAndEffect typeConstraints? equalityConstraintList? EQUAL statement {pin=9}

redefDecl ::= REDEF_KW ident typeParameterList? parameterList COLON typeAndEffect typeConstraints? equalityConstraintList? EQUAL statement

lawDecl ::= LAW_KW ident COLON FORALL_KW typeParameterList? parameterList? typeConstraints? equalityConstraintList? expr

// `private`, a pure dispatcher on RESTRICTABLE_KW: the reference closes a different TreeKind
// (Decl.RestrictableEnum vs Decl.Enum) purely based on that keyword's presence, which a single
// Grammar-Kit rule can't do -- one rule always produces one node kind for every alternative. Split
// into two real rules instead, so the map has something distinct to target; `enumDecl` itself
// stays private so it doesn't add a third wrapper level neither side has.
private enumDecl ::= restrictableEnumDecl | plainEnumDecl
restrictableEnumDecl ::= RESTRICTABLE_KW ENUM_KW ident restrictableEnumIndex? typeParameterList? enumSingletonBody? derivationList? (CURLY_L enumCaseList? CURLY_R)?
plainEnumDecl ::= ENUM_KW ident restrictableEnumIndex? typeParameterList? enumSingletonBody? derivationList? (CURLY_L enumCaseList? CURLY_R)?
private restrictableEnumIndex ::= BRACKET_L parameter BRACKET_R
// Not `private`: the reference wraps a case's payload types in their own `CaseBody` node --
// confirmed for both positions this rule covers, the singleton short-hand (`enum Color(String)`,
// direct child of Decl.Enum) and the regular per-case form (`case Circle(Float64)`, child of
// Case), which share the identical `TreeKind.CaseBody` in Parser2.scala's `enumDecl`/`enumCases`.
enumSingletonBody ::= PAREN_L (type (COMMA type)* COMMA?)? PAREN_R
// The reference parser allows a mix of leading COMMA and/or repeated CASE_KW between cases, so
// the separator is optional: every case carries its own optional leading CASE_KW and an optional
// preceding COMMA. That covers all commonly written forms -- `case A, case B` / `A, B` /
// `case A case B`, the last spread over separate lines. Requiring the COMMA rejected 68 of the
// 428 corpus files; not one multi-case enum in `main/src/library` writes the separator.
private enumCaseList ::= enumCase (COMMA? enumCase)*
enumCase ::= CASE_KW? ident enumSingletonBody?

structDecl ::= STRUCT_KW ident typeParameterList? (CURLY_L (structField (COMMA structField)* COMMA?)? CURLY_R)?
structField ::= modifierList ident COLON type

typeAliasDecl ::= TYPE_KW ALIAS_KW ident typeParameterList? EQUAL type

associatedTypeSigDecl ::= TYPE_KW ident typeParameterList? (COLON kind)? (EQUAL type)?
associatedTypeDefDecl ::= TYPE_KW ident typeArgumentList? EQUAL type

effectDecl ::= EFF_KW ident typeParameterList? (CURLY_L effectOperation* CURLY_R)?
effectOperation ::= annotationList modifierList DEF_KW ident typeParameterList? parameterList? COLON type typeConstraints?

// ---- shared declaration fragments ----

modifierList ::= (PUB_KW | SEALED_KW | LAWFUL_KW | MUT_KW)*
annotationList ::= ANNOTATION*

parameterList ::= PAREN_L (parameter (COMMA parameter)* COMMA?)? PAREN_R
parameter ::= ident (COLON type)?

typeParameterList ::= BRACKET_L (typeParameter (COMMA typeParameter)* COMMA?)? BRACKET_R
typeParameter ::= ident (COLON kind)?

typeArgumentList ::= BRACKET_L (typeArgument (COMMA typeArgument)* COMMA?)? BRACKET_R
typeArgument ::= type

typeConstraints ::= WITH_KW typeConstraint (COMMA typeConstraint)*
typeConstraint ::= qualifiedName BRACKET_L type BRACKET_R

equalityConstraintList ::= WHERE_KW equalityConstraint (COMMA equalityConstraint)*
equalityConstraint ::= type TILDE type

derivationList ::= WITH_KW qualifiedName (COMMA qualifiedName)*

// =================================================================================================
// EXPRESSIONS
// =================================================================================================

// Simplification #4 partially reversed: Parser2.Expr.statement()'s error-recovery loop treats two
// token classes specially when SEMI was expected between two statement operands (TokenKind's own
// notBinaryOperator / canFollowBinaryOperator):
//
//   - LET_KW/FOREACH_KW/DISCARD_KW (notBinaryOperator) can never continue an expression, so their
//     presence unconditionally means a semicolon was forgotten: synthesize an empty error marker
//     in its place and keep parsing as if it were there (`missingSemicolonError`, an empty
//     ErrorTree -- same tree shape as a real SEMI, which is itself invisible to the comparison
//     since bare tokens carry no `kind`; see Conformance.kt's kindTree).
//   - Anything that could plausibly be an *operand* of a binary expression
//     (canFollowBinaryOperator: literals, false/true/null/if/match/not, bare names) instead means
//     a binary *operator* was forgotten: synthesize an empty Operator[OperatorError] node between
//     the two operands, producing an Expr.Binary (`statementOperand`/`implicitOperator`).
//     Deliberately excludes DEF_KW (among many others) even though `localDefExpr` can start an
//     expr: without that exclusion this recovery would swallow the *next top-level declaration*
//     into the current statement -- `def foo(): Int32 = 1` immediately followed by
//     `def bar(): Int32 = 2` would parse `def bar...` as a nested local def inside foo's body,
//     since nothing here requires the missing operator's right operand to make semantic sense.
//     Both gates are genuine zero-width lookahead (Grammar-Kit's `&`, matching PEG's and-predicate
//     -- verified against the generated parser code, `_AND_`, before trusting it), not a bare
//     token reference, so the actual gating token is left for the next `expr` to consume.
//
// Still not modeled: the reference's line-sensitivity for the second case (same source line as
// the previous expression -> Binary/OperatorError; different line -> the same ErrorTree-based
// substitution as the first case). This grammar has no line-sensitive lookahead, so the
// binary-operator recovery fires the same way regardless of line. Acceptable: this whole path is
// unreachable for well-formed input (the 428-file corpus already parses cleanly without any of
// this) and only changes the *shape* of an already-malformed parse, not whether it succeeds.
statement ::= statementOperand ((SEMI | missingSemicolonError) statementOperand)*

private missingSemicolonBeforeToken ::= LET_KW | FOREACH_KW | DISCARD_KW
private missingSemicolonGate ::= &missingSemicolonBeforeToken
missingSemicolonError ::= missingSemicolonGate

private canFollowBinaryOperatorToken ::=
    HOLE_ANONYMOUS | FALSE_KW | IF_KW | MATCH_KW | NOT_KW | NULL_KW | TRUE_KW
  | NAME_LOWERCASE | NAME_UPPERCASE | NAME_MATH
  | LITERAL_INT | LITERAL_INT8 | LITERAL_INT16 | LITERAL_INT32 | LITERAL_INT64 | LITERAL_BIGINT
  | LITERAL_FLOAT | LITERAL_FLOAT32 | LITERAL_FLOAT64 | LITERAL_BIGDECIMAL
  | LITERAL_CHAR | LITERAL_REGEX | LITERAL_STRING | LITERAL_STRING_INTERPOLATION_L
private implicitOperatorGate ::= &canFollowBinaryOperatorToken
operatorError ::= implicitOperatorGate
implicitOperator ::= operatorError

// Dual-listed ignored/mapped in the projection map, same pattern as every precedence-chain level:
// arity 1 (no implicit-operator recovery fired) elides transparently; arity 2+ maps to Expr.Binary.
statementOperand ::= expr statementImplicitOperatorTail*
left statementImplicitOperatorTail ::= implicitOperator expr

// ---- precedence chain, loosest to tightest (mirrors Parser2.Expr.Op.precedence exactly) ----

// Every precedence level below wraps its operator token(s) in its own `*Operator` rule, each
// mapping to the reference's single `Operator` kind (many native names to one canonical kind,
// same shape as every level already mapping to Expr.Binary/Expr.Unary). Parser2.scala's
// `binaryOp()`/`unaryExpr()` wrap literally every operator this way, uniformly -- confirmed
// against real fixture output (`<+>`, `:::`, `instanceof` all produce `Expr.Binary` with an
// `Operator` child), not assumed from the two positions (backtick infix, generic/math operator)
// found first. Before this, none of these tokens produced any node at all (bare alternatives in
// the enclosing rule), so the operator itself was invisible to comparison.
expr ::= instanceofExpr

// Every binary precedence level below uses Grammar-Kit's `left` rule modifier ("take an AST
// node on the left (previous sibling) and enclose it by becoming its parent" -- Grammar-Kit's
// README.md), not true grammar-level left recursion. Parsing stays flat/iterative (the `X
// XTail*` shape generates a plain `while` loop, no backtracking), and PSI tree construction
// folds each repetition into a properly left-associative nested tree as an O(1)-per-repetition
// marker-reparenting step -- the same mechanism every JetBrains-authored Grammar-Kit grammar
// uses for binary expressions. A naive self-recursive rule
// (`additiveExpr ::= additiveExpr additiveOperator multiplicativeExpr | multiplicativeExpr`)
// was tried first and reverted: it parsed a synthetic 8-operand chain of bare identifiers in
// single-digit milliseconds, but hung indefinitely on the very first real corpus file
// (`Abort.flix`), reproduced down to a minimal case (`bold(red(fromString(m))) + nl + header +
// nl + trace` -- a several-levels-deep nested-call operand chained with plain identifiers,
// ordinary code, not a contrived edge case). Every level here is verified against the full
// 428-file corpus, not just the one that first surfaced the naive-recursion defect.
instanceofExpr ::= orExpr instanceofExprTail*
left instanceofExprTail ::= instanceofOperator orExpr
instanceofOperator ::= INSTANCEOF_KW
orExpr ::= andExpr orExprTail*
left orExprTail ::= orOperator andExpr
orOperator ::= OR_KW
andExpr ::= equalityExpr andExprTail*
left andExprTail ::= andOperator equalityExpr
andOperator ::= AND_KW
equalityExpr ::= relationalExpr equalityExprTail*
left equalityExprTail ::= equalityOperator relationalExpr
equalityOperator ::= EQUAL_EQUAL | ANGLED_EQUAL | BANG_EQUAL
relationalExpr ::= consExpr relationalExprTail*
left relationalExprTail ::= relationalOperator consExpr
relationalOperator ::= ANGLE_L | ANGLE_R | ANGLE_L_EQUAL | ANGLE_R_EQUAL
// `::`/`:::` are right-associative per Parser2.Expr.Op.isRightAssoc -- modeled as self-recursion
// on the right rather than the usual left-iterative `(OP next)*` chain used everywhere else.
// Right recursion is ordinary recursive descent (no backtracking, no `left` needed): each level
// is only ever entered once per position, unlike the naive *left*-recursive shape that hung.
consExpr ::= additiveExpr (consOperator consExpr)?
consOperator ::= COLON_COLON | COLON_COLON_COLON
additiveExpr ::= multiplicativeExpr additiveExprTail*
left additiveExprTail ::= additiveOperator multiplicativeExpr
additiveOperator ::= PLUS | MINUS
multiplicativeExpr ::= channelPutExpr multiplicativeExprTail*
left multiplicativeExprTail ::= multiplicativeOperator channelPutExpr
multiplicativeOperator ::= STAR | SLASH
channelPutExpr ::= discardExpr channelPutExprTail*
left channelPutExprTail ::= channelPutOperator discardExpr
channelPutOperator ::= ANGLED_PLUS
discardExpr ::= discardOperator discardExpr | infixAppExpr
discardOperator ::= DISCARD_KW
// Both `infixOperatorName` and `operatorSymbol` map to the reference's single `Operator` kind
// (flix-spec's projection map: many native names to one canonical kind, same as every precedence
// level already mapping to Expr.Binary). Neither existed before: the backtick-delimited name and
// the bare symbolic-operator token both parsed with no distinct node of their own, so the
// reference's Operator wrapper had nothing to map onto -- confirmed via flix-spec's conformance
// suite, which found the operator-name position indistinguishable from any other qualified name
// or bare identifier once `ident`/`qualifiedName` themselves became comparable.
infixAppExpr ::= userOpExpr infixAppExprTail*
left infixAppExprTail ::= TICK infixOperatorName TICK userOpExpr
infixOperatorName ::= qualifiedName
userOpExpr ::= lazyForceExpr userOpExprTail*
left userOpExprTail ::= operatorSymbol lazyForceExpr
operatorSymbol ::= GENERIC_OPERATOR | NAME_MATH
lazyForceExpr ::= lazyForceOperator lazyForceExpr | signExpr
lazyForceOperator ::= LAZY_KW | FORCE_KW
signExpr ::= signOperator signExpr | notExpr
signOperator ::= PLUS | MINUS
notExpr ::= notOperator notExpr | postfixExpr
notOperator ::= NOT_KW

// ---- postfix chain: function application, field/method access, indexing ----

postfixExpr ::= exprDelimited postfixSuffix*
private postfixSuffix ::=
    argumentList                                          // f(args)  (Apply)
  | DOT NAME_LOWERCASE argumentList?                       // e.f  /  e.f(args)  (GetField / InvokeMethod)
  | HASH NAME_LOWERCASE                                    // e#f  (RecordSelect)
  | arrow NAME_LOWERCASE (EQUAL expr)?                      // e->f  /  e->f = v  (StructGet / StructPut; `arrow` merges tight/whitespace "->", see header note #2)
  | BRACKET_L expr BRACKET_R (EQUAL expr)?                  // e[i]  /  e[i] = v  (Index / IndexMut)

// Tried `{pin=1}` on `argumentList` three times before this and reverted all three -- see git
// history for the full account. Attempts 1 and 3 both broke on the exact same input
// (`testUnclosedExtTagArgsRecovers`'s truncated `xvar A(` immediately followed by a real
// top-level `def`), and dumping the actual PSI tree (not just the pass/fail signal) for that
// input finally showed *why*, not just *that* it failed: once PAREN_L pins the rule, the
// generated parser goes on to try parsing an `argument` at the current position regardless of
// what that position holds -- and `argument`'s `expr` genuinely CAN start with DEF_KW, via
// `localDefExpr` (a local def used as an expression, e.g. `{ def g(): Int32 = 1; g() }`). So the
// pinned parser doesn't fail to find an argument and leave `def` alone the way the unpinned
// version did -- it happily parses the entire *next top-level declaration* as if it were a local
// def passed as an argument, because that's a completely well-formed `expr` in isolation.
// Parser2.scala's own `arguments()` hits this identically and has an explicit guard for it (see
// its own comment): "Remove KeywordDef from isFirstExpr for arguments only. This handles the
// common case of incomplete arguments followed by another declaration gracefully." `!DEF_KW`
// below is that same guard, gating both the first argument and every argument after a comma (a
// truncated call could be followed by a comma before hitting the next declaration too) --
// verified the pin is now safe by dumping the same input's PSI tree again and confirming
// `afterUnclosedXvar` parses as a sibling top-level Decl.Def, not a swallowed argument, before
// trusting the full test suite's green result.
argumentList ::= PAREN_L (argumentListContents)? PAREN_R {pin=1}
private argumentListContents ::= !DEF_KW argument (COMMA !DEF_KW argument)* COMMA?
argument ::= expr (EQUAL expr)?

// Both spellings of "->" are accepted everywhere an arrow is expected (see header note #2).
private arrow ::= ARROW_THIN_R | ARROW_THIN_R_TIGHT

// ---- delimited / atomic expressions ----

exprDelimited ::=
    debugInterpolatorExpr
  | openVariantExpr
  | openVariantAsExpr
  | holeExpr
  | holeVariableExpr
  | useExpr
  | literalExpr
  | interpolatedStringExpr
  | parenOrTupleOrLambdaExpr
  | structPutExpr
  | unaryLambdaExpr
  | qualifiedName
  | ifExpr
  | letExpr
  | localDefExpr
  | regionExpr
  | matchOrMatchLambdaExpr
  | restrictableChooseExpr
  | forApplicativeExpr
  | foreachExpr
  | forMonadicExpr
  | blockOrRecordExpr
  | arrayLiteralExpr
  | vectorLiteralExpr
  | listLiteralExpr
  | setLiteralExpr
  | mapLiteralExpr
  | checkedTypeCastExpr
  | checkedEffectCastExpr
  | uncheckedCastExpr
  | unsafeExpr
  | runExpr
  | handlerExpr
  | tryExpr
  | throwExpr
  | ambiguousNewExpr
  | invokeSuperExpr
  | staticExpr
  | selectExpr
  | spawnExpr
  | parYieldExpr
  | fixpointSolveExpr
  | fixpointConstraintSetExpr
  | fixpointLambdaExpr
  | fixpointPQueryExpr
  | fixpointInjectExpr
  | fixpointQueryExpr
  | intrinsicExpr
  | extMatchOrLambdaExpr
  | extTagExpr

debugInterpolatorExpr ::= DEBUG_INTERPOLATOR exprDelimited

openVariantExpr ::= OPEN_VARIANT_KW qualifiedName
openVariantAsExpr ::= OPEN_VARIANT_AS_KW qualifiedName expr

holeExpr ::= HOLE_ANONYMOUS | HOLE_NAMED
holeVariableExpr ::= HOLE_VARIABLE

useExpr ::= useDecl SEMI statement

literalExpr ::=
    LITERAL_STRING | LITERAL_CHAR
  | LITERAL_FLOAT | LITERAL_FLOAT32 | LITERAL_FLOAT64 | LITERAL_BIGDECIMAL
  | LITERAL_INT | LITERAL_INT8 | LITERAL_INT16 | LITERAL_INT32 | LITERAL_INT64 | LITERAL_BIGINT
  | TRUE_KW | FALSE_KW | NULL_KW | LITERAL_REGEX

// `pin=1` commits once the opening LITERAL_STRING_INTERPOLATION_L is seen, so an interpolation
// missing its closing `}` (LITERAL_STRING_INTERPOLATION_R never arrives, e.g. because the source
// truncates at EOF: `"${x` with nothing after) doesn't fail the whole interpolated-string
// expression -- it reports a missing-token error and closes normally instead. Unlike
// `argumentList`, there is no trailing *optional* step after the last required piece here (no
// analogue of `argument`'s `expr` that could itself start swallowing unrelated content, e.g. via
// `localDefExpr`'s DEF_KW) -- the only thing after the last interpolated `expr` is a single
// required token, so this is a strictly narrower, lower-risk shape than argumentList's pin.
// `interpolatedStringExpr` also has exactly one call site (immediately below), unlike
// `argumentList`'s five, so there is no possibility of an unrelated sibling rule leaving a
// half-consumed `"${` for an *outer* rule's pinned alternative to collide with the way
// `postfixSuffix`'s pinned `argumentList` alternative collided with `extTagExpr`'s own attempt.
interpolatedStringExpr ::= LITERAL_STRING_INTERPOLATION_L expr (LITERAL_STRING_INTERPOLATION_L expr)* LITERAL_STRING_INTERPOLATION_R {pin=1}

// A struct put on a bare receiver -- `counter->state = x` -- is otherwise swallowed by
// unaryLambdaExpr, which matches `counter -> state` as a lambda and then chokes on `=`. The
// general `postfixSuffix` form already covers `e->f = v` for any other receiver shape; only the
// bare-identifier case needs to win the ordered choice, so this strictly longer alternative is
// listed ahead of unaryLambdaExpr. Five of the 428 corpus files depended on it.
structPutExpr ::= ident arrow NAME_LOWERCASE EQUAL expr

unaryLambdaExpr ::= ident arrow expr

// `(...)`-headed forms: unit lambda, unit tuple, operator section, lambda, ascription, tuple, paren.
// The plain (no-suffix) case is its own rule, `parenExpr`, rather than folded into this one:
// PAREN_OR_TUPLE_OR_LAMBDA_EXPR is in `ignored` (elides at arity <= 1, correct for the
// unit/operator-section/lambda alternatives above, which never reach arity 1 here), but a plain
// `(u - f)` is exactly arity 1 and the reference's Expr.Paren is a real, mandatory node for it --
// not in `elide` -- so folding it into the same wrapper meant it was always spliced away too.
// `malformedParenExpr` is the last-resort alternative: a bare `(` that none of the shapes below
// can make sense of, e.g. `(1, 2` reaching an enclosing `}` with no closing `)` anywhere before
// it. Parser2.parenOrTupleOrLambdaExpr detects this with an explicit bracket-balance lookahead
// scan (hitting a top-level `}` or EOF before finding the matching `)`) and produces
// `Malformed(Tuple)`, consuming just the `(` -- not something a static grammar rule can replicate
// with real lookahead, but every alternative below already requires a real closing `)` to
// succeed, so if none of them match, that's necessarily because no reachable `)` exists either
// (Grammar-Kit's ordinary backtracking already explores the same space the reference's scan
// checks explicitly). `malformedParenExpr` consuming only `(` and returning is what lets the
// content that follows (`1, 2` here) fall through to `statement`'s own `statementOperand`/
// `implicitOperator` recovery instead of being swallowed by this rule's own failed attempts.
// A first attempt at this, paired with pinning `block`, was reverted (see `block`'s own comment
// above): pinning `block` broke `blockOrRecordExpr`'s disambiguation before that disambiguation
// was resolved by an explicit lookahead predicate instead of backtracking. Now that `block` is
// safely pinned again, `malformedParenExpr` is what actually lets the rest of a malformed tuple's
// content recover once `block`'s own commit keeps the surrounding `{ ... }` from collapsing.
parenOrTupleOrLambdaExpr ::=
    PAREN_L PAREN_R arrow expr                     // unit lambda: () -> e
  | PAREN_L PAREN_R                                // unit
  | PAREN_L operatorToken PAREN_R                  // operator section, e.g. (+)
  | lambdaExpr                                     // (params) -> e
  | PAREN_L expr ascribeSuffix PAREN_R
  | PAREN_L expr tupleSuffix PAREN_R
  | parenExpr
  | malformedParenExpr

parenExpr ::= PAREN_L expr PAREN_R
malformedParenExpr ::= PAREN_L
lambdaExpr ::= parameterList arrow expr
private ascribeSuffix ::= COLON typeAndEffect
private tupleSuffix ::= (EQUAL expr)? (COMMA argument)+

// Set of tokens accepted as a bare "operator section" inside parens, per TokenKind.isOperator.
// Not `private`: the reference wraps this single token in its own `Operator` node too
// (Parser2.scala's operator-section case in `parenOrTupleOrLambdaExpr`, :2057), the same kind
// `operatorSymbol` above maps onto. A different token set from `operatorSymbol` (this one covers
// every operator usable in a section, not just the two `userOpExpr` needs), but both are
// many-native-names-to-one-canonical-kind, same as every precedence level mapping to Expr.Binary.
operatorToken ::= PLUS | MINUS | STAR | SLASH | ANGLE_L | ANGLE_R | ANGLED_EQUAL | ANGLE_L_EQUAL | ANGLE_R_EQUAL | EQUAL_EQUAL | BANG_EQUAL | GENERIC_OPERATOR | COLON_COLON_COLON

ifExpr ::= IF_KW PAREN_L expr PAREN_R expr (ELSE_KW expr)?

letExpr ::= LET_KW pattern (COLON type)? EQUAL statement

localDefExpr ::= annotationList DEF_KW ident parameterList (COLON typeAndEffect)? EQUAL statement

regionExpr ::= REGION_KW ident block?
// `{pin=1}` on the second alternative (via a private `blockWithStatement` sub-rule, since
// Grammar-Kit's pin is rule-level, not alternative-level). A first attempt at this pin was
// reverted earlier on this branch: `blockOrRecordExpr ::= block | recordOperationExpr` relied on
// `block` genuinely failing and backtracking whenever `{...}` content wasn't actually a block, so
// `recordOperationExpr` got a turn -- but a record literal like `{ x = 1, y = 2 }` has a prefix
// (`x`) that's also a valid (partial) `statement` on its own, so once pinned, `block` always
// "succeeded" on that prefix instead of properly failing, permanently starving
// `recordOperationExpr`. Safe now: `blockOrRecordExpr` below resolves block-vs-record with an
// explicit 2-token lookahead predicate *before* choosing (matching Parser2.isBlockExpr() exactly
// -- see `isBlockNotRecord`'s own comment in FlixParserUtil.kt), the same way the reference
// itself avoids ever needing to backtrack between the two. Once that predicate says "block",
// `recordOperationExpr` is never reached at all, so there's nothing left needing `block` to fail
// and backtrack for.
block ::= CURLY_L CURLY_R | blockWithStatement
private blockWithStatement ::= CURLY_L statement CURLY_R {pin=1}

// The braced form is tried first: `match node->next { ... }` would otherwise be swallowed by the
// match-lambda alternative, which matches `node -> next` and then chokes on `{`. Ordering the
// braced form first is safe because a real match lambda has no `{` after its body, so it falls
// through. Three of the 428 corpus files depended on this.
matchOrMatchLambdaExpr ::=
    MATCH_KW expr CURLY_L (matchRule (COMMA? matchRule)*)? CURLY_R
  | MATCH_KW pattern arrow expr
// `=` or `->`/tight-arrow typo'd for `=>` is another Parser2.scala-special-cased mistake, not
// generic recovery (Parser2.Expr.matchRule): consume the wrong token, synthesize an empty
// ErrorTree in place of the expected ARROW_THICK_R, and still parse the rule body normally.
private matchRuleWrongArrow ::= EQUAL | arrow
matchRuleArrowError ::= matchRuleWrongArrow
matchRule ::= CASE_KW pattern (IF_KW expr)? (ARROW_THICK_R | matchRuleArrowError) statement

extMatchOrLambdaExpr ::=
    EMATCH_KW pattern arrow expr
  | EMATCH_KW expr CURLY_L (extMatchRule (COMMA? extMatchRule)*)? CURLY_R
extMatchRule ::= CASE_KW pattern ARROW_THICK_R statement

extTagExpr ::= XVAR_KW ident argumentList?

restrictableChooseExpr ::= (CHOOSE_KW | CHOOSE_STAR_KW) expr CURLY_L (matchRule (COMMA? matchRule)*)? CURLY_R

forApplicativeExpr ::= FORA_KW forFragments YIELD_KW expr
foreachExpr ::= FOREACH_KW forFragments expr
forMonadicExpr ::= FORM_KW forFragments YIELD_KW expr
// The fragment list may be parenthesized -- `foreach (x <- xs) body`, `forM (x <- a; y <- b) yield e`
// -- which is how essentially all real code writes it. Accepting only the bare form rejected 37 of
// the 428 corpus files.
private forFragments ::= PAREN_L forFragmentList PAREN_R | forFragmentList
private forFragmentList ::= forFragment (SEMI forFragment)*
private forFragment ::= guardFragment | generatorOrLetFragment
guardFragment ::= IF_KW expr
generatorOrLetFragment ::= pattern (ARROW_THIN_L expr | EQUAL expr)

// Disambiguates block vs. record with an explicit 2-token lookahead predicate before choosing
// (`isBlockGuard`, zero-width, `private` so it adds no PSI node of its own), matching
// Parser2.isBlockExpr() exactly -- see FlixParserUtil.kt's own comment on `isBlockNotRecord` for
// the full account of why this replaced plain ordered-alternative backtracking.
private isBlockGuard ::= <<isBlockNotRecord>>
blockOrRecordExpr ::= (isBlockGuard block) | recordOperationExpr
recordOperationExpr ::= CURLY_L (recordOp (COMMA recordOp)* COMMA?)? (BAR expr)? CURLY_R
recordOp ::=
    PLUS ident EQUAL expr    // RecordOpExtend
  | MINUS ident              // RecordOpRestrict
  | ident EQUAL expr         // RecordOpUpdate

arrayLiteralExpr ::= ARRAY_HASH CURLY_L (expr (COMMA expr)* COMMA?)? CURLY_R regionName
vectorLiteralExpr ::= VECTOR_HASH CURLY_L (expr (COMMA expr)* COMMA?)? CURLY_R
listLiteralExpr ::= LIST_HASH CURLY_L (expr (COMMA expr)* COMMA?)? CURLY_R
setLiteralExpr ::= SET_HASH CURLY_L (expr (COMMA expr)* COMMA?)? CURLY_R
mapLiteralExpr ::= MAP_HASH CURLY_L (mapEntry (COMMA mapEntry)* COMMA?)? CURLY_R
mapEntry ::= expr ARROW_THICK_R expr

regionName ::= AT expr

checkedTypeCastExpr ::= CHECKED_CAST_KW (PAREN_L expr PAREN_R)?
checkedEffectCastExpr ::= CHECKED_ECAST_KW (PAREN_L expr PAREN_R)?
uncheckedCastExpr ::= UNCHECKED_CAST_KW (PAREN_L expr (AS_KW typeAndEffect)? PAREN_R)?
unsafeExpr ::= UNSAFE_KW type (AS_KW type)? CURLY_L statement CURLY_R

runExpr ::= RUN_KW expr withBody*
withBody ::= WITH_KW expr

handlerExpr ::= HANDLER_KW qualifiedName (CURLY_L (withRule (COMMA? withRule)*)? CURLY_R)?
withRule ::= DEF_KW ident parameterList EQUAL expr

tryExpr ::= TRY_KW expr catchBody*
catchBody ::= CATCH_KW CURLY_L (catchRule (COMMA? catchRule)*)? CURLY_R
catchRule ::= CASE_KW ident COLON qualifiedName ARROW_THICK_R statement

throwExpr ::= THROW_KW expr

// One native kind can't produce two different reference TreeKinds: `super.method(...)` closes
// Expr.InvokeSuperMethod, bare `super(...)` closes Expr.InvokeSuperConstructor
// (Parser2.scala's invokeSuperExpr dispatches on whether a `.` follows `super`) -- same shape
// as the enumDecl/restrictableEnumDecl and solve/psolve splits. Private dispatcher over two
// real rules, so no third wrapper level is added.
private invokeSuperExpr ::= invokeSuperMethodExpr | invokeSuperConstructorExpr
invokeSuperMethodExpr ::= SUPER_KW DOT ident argumentList
invokeSuperConstructorExpr ::= SUPER_KW argumentList

ambiguousNewExpr ::= NEW_KW type newBody
private newBody ::=
    AT expr (CURLY_L (structFieldInit (COMMA structFieldInit)*)? CURLY_R)   // new Struct @ rc { ... }
  | CURLY_L jvmMember* CURLY_R                                              // new Type { ... } (anonymous class)
  | argumentList                                                            // new Type(args)   (InvokeConstructor)
structFieldInit ::= ident EQUAL expr
private jvmMember ::= jvmConstructor | jvmMethod

// A JVM method name that happens to be a reserved keyword (e.g. `def run(): ...` inside an
// anonymous class -- `run` is RUN_KW, not a name token) is Parser2.nameUnqualified's own
// keyword-fallback: consume the keyword and produce a bare ErrorTree in place of the name
// (not an Ident wrapping one, since the ident position itself never matched), then keep parsing
// the rest of the method signature/body normally. Reference: "If the keyword can start a
// declaration it's best to leave it be" -- i.e. this only fires for keywords that *aren't*
// themselves `declarationStart` (see that rule's own comment above `declaration`), since those
// need to be left alone for `declaration`'s own recovery to find; and never for STATIC_UPPER_KW,
// which `ident` itself already accepts as a legitimate name token. The list below is every other
// keyword: all 79, minus declarationStart's 17 (MOD/TRAIT/INSTANCE/DEF/REDEF/LAW/ENUM/STRUCT/
// TYPE/EFF/RESTRICTABLE/PUB/SEALED/LAWFUL/MUT/USE/IMPORT), minus STATIC_UPPER_KW.
jvmMethodNameError ::=
    ALIAS_KW | AND_KW | AS_KW | CASE_KW | CATCH_KW | CHECKED_CAST_KW
  | CHECKED_ECAST_KW | CHOOSE_KW | CHOOSE_STAR_KW | DISCARD_KW | ELSE_KW | EMATCH_KW
  | FALSE_KW | FIX_KW | FORA_KW | FORM_KW | FORALL_KW | FORCE_KW
  | FOREACH_KW | FROM_KW | HANDLER_KW | IF_KW | INJECT_KW | INSTANCEOF_KW
  | INTO_KW | LAZY_KW | LET_KW | MATCH_KW | NEW_KW | NOT_KW
  | NULL_KW | OPEN_VARIANT_KW | OPEN_VARIANT_AS_KW | OR_KW | PQUERY_KW | PSOLVE_KW
  | PAR_KW | PROJECT_KW | QUERY_KW | REGION_KW | RUN_KW | RVADD_KW
  | RVAND_KW | RVNOT_KW | RVSUB_KW | SELECT_KW | SOLVE_KW | SPAWN_KW
  | STATIC_KW | SUPER_KW | THROW_KW | TRUE_KW | TRY_KW | UNCHECKED_CAST_KW
  | UNIV_KW | UNSAFE_KW | WHERE_KW | WITH_KW | XOR_KW | XVAR_KW
  | YIELD_KW
jvmMethod ::= annotationList DEF_KW (ident | jvmMethodNameError) parameterList COLON typeAndEffect EQUAL statement
jvmConstructor ::= DEF_KW NEW_KW PAREN_L PAREN_R COLON typeAndEffect EQUAL statement

staticExpr ::= STATIC_UPPER_KW

selectExpr ::= SELECT_KW CURLY_L selectRule* CURLY_R
private selectRule ::=
    CASE_KW ident ARROW_THIN_L qualifiedName PAREN_L expr PAREN_R ARROW_THICK_R statement   // SelectRuleFragment
  | CASE_KW UNDERSCORE ARROW_THICK_R statement                                              // SelectRuleDefaultFragment (must be last)

spawnExpr ::= SPAWN_KW expr regionName

parYieldExpr ::= PAR_KW (PAREN_L (parYieldFragment (SEMI parYieldFragment)*)? PAREN_R)? YIELD_KW expr
parYieldFragment ::= pattern ARROW_THIN_L expr

// ---- fixpoint / Datalog expressions ----

fixpointConstraintSetExpr ::= HASH_CURLY_L fixpointConstraint* CURLY_R
fixpointConstraint ::= predicateHead (COLON_MINUS predicateBody (COMMA predicateBody)*)? DOT_WHITESPACE

fixpointLambdaExpr ::= predicateParamList arrow expr

// One native kind can't produce two different reference TreeKinds: `solve` closes
// Expr.FixpointSolveWithProject (it can carry a `project` clause) and `psolve` closes
// Expr.FixpointSolveWithProvenance (Parser2.Expr.fixpointSolveExpr's early return for
// isPSolve, which never takes one) -- same shape as the enumDecl/restrictableEnumDecl split.
// Split into a private dispatcher over two real rules, so no third wrapper level is added.
private fixpointSolveExpr ::= provenanceSolveExpr | projectSolveExpr
provenanceSolveExpr ::= PSOLVE_KW expr (COMMA expr)*
projectSolveExpr ::= SOLVE_KW expr (COMMA expr)* (PROJECT_KW ident (COMMA ident)*)?

fixpointInjectExpr ::= INJECT_KW expr (COMMA expr)* INTO_KW predicateAndArity (COMMA predicateAndArity)*
predicateAndArity ::= ident SLASH LITERAL_INT

fixpointPQueryExpr ::= PQUERY_KW expr (COMMA expr)* SELECT_KW predicateHead WITH_KW CURLY_L (ident (COMMA ident)*)? CURLY_R

fixpointQueryExpr ::= QUERY_KW expr (COMMA expr)* (SELECT_KW fixpointSelectBody)? (FROM_KW predicateAtom (COMMA predicateAtom)*)? (WHERE_KW expr)?
// Simplification #7: the reference parser special-cases a bare "()" select body, but that shape
// is already handled generally by `expr` (via parenOrTupleOrLambdaExpr's unit alternative).
private fixpointSelectBody ::= expr | PAREN_L (expr (COMMA expr)* COMMA?)? PAREN_R

intrinsicExpr ::= BUILT_IN

// =================================================================================================
// PATTERNS
// =================================================================================================

pattern ::= patternPrimary (COLON_COLON pattern)?   // FCons, right-associative like `::` in expr

private patternPrimary ::=
    variablePattern
  | literalPattern
  | tagPattern
  | tuplePattern
  | recordPattern
  | unaryPattern

// Simplification: the reference parser also dispatches on the KEYWORD_QUERY token here, but its
// callee (`nameUnqualified(NAME_VARIABLE)`) never actually accepts that token kind, so reaching
// this case always produces a recovered error node -- an error-recovery detail, not a legal
// pattern shape, so it is intentionally omitted here.
variablePattern ::= NAME_LOWERCASE | NAME_MATH | UNDERSCORE

literalPattern ::=
    LITERAL_STRING | LITERAL_CHAR
  | LITERAL_FLOAT | LITERAL_FLOAT32 | LITERAL_FLOAT64 | LITERAL_BIGDECIMAL
  | LITERAL_INT | LITERAL_INT8 | LITERAL_INT16 | LITERAL_INT32 | LITERAL_INT64 | LITERAL_BIGINT
  | TRUE_KW | FALSE_KW | LITERAL_REGEX | NULL_KW

// Simplification #6 (see header): extensible-variant patterns are not modeled separately; ordinary
// tag patterns (this rule) also cover that syntactic position.
tagPattern ::= qualifiedName tagBodyPattern?
tagBodyPattern ::= PAREN_L (pattern (COMMA pattern)* COMMA?)? PAREN_R

tuplePattern ::= PAREN_L (pattern (COMMA pattern)* COMMA?)? PAREN_R

recordPattern ::= CURLY_L (recordFieldPattern (COMMA recordFieldPattern)* COMMA?)? (BAR pattern)? CURLY_R
recordFieldPattern ::= ident (EQUAL pattern)?

// The reference parser's unaryPat() just advances over the operator and whatever token follows
// (in practice always a negative numeric literal); modeled directly as such.
unaryPattern ::= MINUS literalPattern

// =================================================================================================
// PREDICATES (Datalog)
// =================================================================================================

predicateHead ::= ident termList?
termList ::= PAREN_L (expr (COMMA expr)* COMMA?)? (SEMI latticeTermExpr)? PAREN_R
// Was `private`, inlining with no node of its own; the reference wraps the lattice-term tail in
// a real, mandatory Predicate.LatticeTerm regardless of the term's own shape.
latticeTermExpr ::= expr

patternList ::= PAREN_L (pattern (COMMA pattern)* COMMA?)? (SEMI latticeTermPattern)? PAREN_R
// Same fix as latticeTermExpr above, pattern-position counterpart.
latticeTermPattern ::= pattern

predicateBody ::= guard | functional | predicateAtom
guard ::= IF_KW PAREN_L expr PAREN_R
functional ::= LET_KW (ident | PAREN_L (ident (COMMA ident)* COMMA?)? PAREN_R) EQUAL expr
predicateAtom ::= NOT_KW? FIX_KW? ident patternList?

predicateParamList ::= HASH_PAREN_L (predicateParam (COMMA predicateParam)* COMMA?)? PAREN_R
predicateParam ::= ident (PAREN_L (type (COMMA type)* COMMA?)? (SEMI type)? PAREN_R)?

// =================================================================================================
// TYPES
// =================================================================================================

// `/` instead of `\` for the effect separator is a common typo Parser2.Type.typeAndEffect
// special-cases directly (not generic recovery): ParseError.ExpectedBackslashGotSlash, consuming
// the `/` and still going on to parse the effect type normally rather than losing the whole
// type-and-effect suffix. `typeAndEffectSlashError` is deliberately not `private`: its only
// content is the SLASH token, which -- like every bare token -- carries no `kind` and so is
// already invisible to the conformance comparison (see Conformance.kt's kindTree, "drops token
// leaves"); giving it a real node of its own is what makes it land as the reference's empty
// ErrorTree sibling instead of vanishing into typeAndEffect's `flatten`ed children entirely.
typeAndEffectSlashError ::= SLASH
typeAndEffect ::= type ((BACKSLASH type) | (typeAndEffectSlashError type))?

// Kind ascription (": Kind") applies once, around the whole binary-operator chain, matching
// Parser2.Type.ttype's trailing `if (eat(Colon)) { ... Ascribe }` step. One native TYPE kind
// can't produce two different reference TreeKinds (Type.Type when absent -- transparent, per
// TYPE's existing ignored/elide dual-listing below -- vs Type.Ascribe when present); same shape
// as the enumDecl/solve/super splits, but expressed with `left` (as for the precedence chain)
// rather than a private dispatcher: `type` is the entry point for every type position in this
// grammar, so a dispatcher's fallback alternative would re-parse the entire arrowType chain a
// second time on every ordinary (unascribed) type, which is the overwhelming common case.
// `left` parses arrowType exactly once and only wraps it if `: kind` actually follows.
type ::= arrowType typeAscribeTail?
left typeAscribeTail ::= COLON kind

// ---- precedence chain, loosest to tightest (mirrors Parser2.Type.TYPE_OP_PRECEDENCE exactly) ----
// Every level except arrow is left-associative (the reference algorithm has no isRightAssoc
// override for types, unlike Expr's `::`/`:::`), so the standard `(OP next)*` chain is faithful
// for those. Arrow is the exception -- see below.

// Right-associative and recursive through `type`, not a flat `(arrow rvAddSubType)*` loop: an
// effect binds to an arrow's *result*, not just to a declaration's return type, because
// `Parser2.Type.ttype` returns `typeAndEffect()` -- not a plain `ttype()` -- for the right operand
// of every whitespace-arrow. `a -> b -> c` therefore parses as `a -> (b -> c)`, and each arrow's
// own result can carry its own `\ effect` independently of any other arrow in the chain: `f: a ->
// b \ eb -> c \ ec` attaches `eb` to `b` and `ec` to the whole `b \ eb -> c`, not both to `c`. An
// earlier version of this rule accepted the suffix only in `typeAndEffect` (the outermost,
// declaration-return position) and rejected 103 of the 428 corpus files, `List.map`'s signature
// among them; a later version widened it to a flat trailing suffix on the *whole* arrow chain
// instead, which parses every real file but produces the wrong tree shape for a non-arrow type
// with a bare effect suffix (`Unit \ IO` was wrongly wrapped as Type.Function, since the trailing
// `(BACKSLASH type)?` gave `arrowType` arity 2 even with no arrow at all). This mirrors the
// reference's actual recursive structure instead of approximating it either way.
// Every binary/unary type operator gets its own `*Operator` wrapper, same as the expression
// precedence chain (see infixAppExpr's comment): Parser2.Type.ttype's Pratt loop and unaryType()
// wrap literally every type operator token as Operator too, uniformly. `arrow` itself stays
// `private` -- it is also used bare at several non-operator positions (lambda syntax, struct-put,
// kind arrows), which do not share Type.Binary's shape, so `arrowOperator` wraps it only here.
arrowType ::= rvAddSubType (arrowOperator type (BACKSLASH type)?)?
arrowOperator ::= arrow
// `left` throughout (see the expression precedence chain's comment for why, and what it
// replaces): every level below is a binary chain, verified against the full 428-file corpus.
rvAddSubType ::= rvAndType rvAddSubTypeTail*
left rvAddSubTypeTail ::= rvAddSubOperator rvAndType
rvAddSubOperator ::= RVADD_KW | RVSUB_KW
rvAndType ::= addSubType rvAndTypeTail*
left rvAndTypeTail ::= rvAndOperator addSubType
rvAndOperator ::= RVAND_KW
addSubType ::= ampType addSubTypeTail*
left addSubTypeTail ::= addSubOperator ampType
addSubOperator ::= PLUS | MINUS
ampType ::= xorType ampTypeTail*
left ampTypeTail ::= ampOperator xorType
ampOperator ::= AMPERSAND
xorType ::= orType xorTypeTail*
left xorTypeTail ::= xorOperator orType
xorOperator ::= XOR_KW
orType ::= andType orTypeTail*
left orTypeTail ::= orTypeOperator andType
orTypeOperator ::= OR_KW
andType ::= unaryTypeLevel andTypeTail*
left andTypeTail ::= andTypeOperator unaryTypeLevel
andTypeOperator ::= AND_KW
unaryTypeLevel ::= unaryTypeOperator unaryTypeLevel | typeApplication
unaryTypeOperator ::= RVNOT_KW | TILDE | NOT_KW

typeApplication ::= typeDelimited typeArgumentList*

// `typeVariable` before `qualifiedTypeName`: both can start with NAME_LOWERCASE (a bare lowercase
// name is ambiguous between "type variable" and "single-segment qualified type name" from the
// token alone), and Grammar-Kit's ordered choice takes the first alternative that matches, so
// listing `qualifiedTypeName` first made `typeVariable` unreachable -- every bare lowercase name
// parsed as a one-segment qualified type name instead, silently. The reference compiler has no
// such ambiguity because it dispatches on token kind directly (Parser2.scala's `typeDelimited`:
// NameLowercase -> variableType(), NameUppercase -> a qualified type name); this ordering
// reproduces that by falling through to `qualifiedTypeName` only when `typeVariable` cannot match
// (NAME_UPPERCASE and multi-segment names are outside `typeVariable`'s token set).
typeDelimited ::=
    typeVariable
  | qualifiedTypeName
  | constantType
  | tupleOrRecordRowType
  | recordOrEffectSetType
  | extensibleType
  | schemaType
  | schemaRowType
  | caseSetType

qualifiedTypeName ::= qualifiedName
typeVariable ::= NAME_LOWERCASE | NAME_MATH | UNDERSCORE
constantType ::= UNIV_KW | FALSE_KW | TRUE_KW

// `(...)` is ambiguous between a record row and a tuple; ordered so record-row (including the
// empty-parens "unit" shape, per Parser2.Type.tupleOrRecordRowType's `next == ParenR` case) is
// tried first, falling back to a plain tuple via backtracking.
tupleOrRecordRowType ::= recordRowType | tupleType
recordRowType ::= PAREN_L (recordFieldType (COMMA recordFieldType)* COMMA?)? (BAR type)? PAREN_R
recordFieldType ::= ident EQUAL type
tupleType ::= PAREN_L (type (COMMA type)* COMMA?)? PAREN_R

// `{...}` is ambiguous between a record type and an effect set; likewise resolved by ordered
// alternation + backtracking rather than explicit lookahead. `recordType`'s alternatives must
// each require *something* between the braces -- Parser2.scala's recordOrEffectSetType()
// special-cases bare `{}` as an effect set (isRecord=false when the very next token is CurlyR),
// and since recordType is tried first here, a fully-optional inner group would let it steal the
// empty-braces match before effectSetType ever gets a turn.
recordOrEffectSetType ::= recordType | effectSetType
recordType ::= (CURLY_L BAR CURLY_R)
             | (CURLY_L BAR type CURLY_R)
             | (CURLY_L recordFieldType (COMMA recordFieldType)* COMMA? (BAR type)? CURLY_R)
effectSetType ::= CURLY_L (type (COMMA type)* COMMA?)? CURLY_R

extensibleType ::= HASH_BAR (schemaTerm (COMMA schemaTerm)* COMMA?)? (BAR ident)? BAR_HASH
schemaType ::= HASH_CURLY_L (schemaTerm (COMMA schemaTerm)* COMMA?)? (BAR ident)? CURLY_R
schemaRowType ::= HASH_PAREN_L (schemaTerm (COMMA schemaTerm)* COMMA?)? (BAR ident)? PAREN_R
// PredicateWithAlias (qname + type-argument-list) vs. PredicateWithTypes (qname + optional
// parenthesized term-type-list with an optional trailing lattice type).
schemaTerm ::= qualifiedName (typeArgumentList | schemaTermTypeList?)
private schemaTermTypeList ::= PAREN_L (type (COMMA type)* COMMA?)? (SEMI latticeTermType)? PAREN_R
private latticeTermType ::= type

caseSetType ::= ANGLE_L (qualifiedName (COMMA qualifiedName)* COMMA?)? ANGLE_R

kind ::= (PAREN_L ident (arrow kind)? PAREN_R) | (ident (arrow kind)?)
