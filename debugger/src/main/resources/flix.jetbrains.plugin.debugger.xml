<idea-plugin>
    <!-- Flix support for IntelliJ's own JVM debugger (docs/adr/0002-native-jvm-debugger.md).

         Scoped to the backend. Both extensions below are consumed by the Java debug process:
         DebugProcessImpl builds its CompoundPositionManager from positionManagerFactory, and
         DebuggerUtils.isBreakpointAware consults javaDebugAware when deciding whether a line can
         take a breakpoint. Under split mode that runs backend-side, so loading this module on the
         frontend would register extensions nothing there will ever ask for.

         The Java plugin dependency is scoped here for the same reason this is a separate module at
         all: com.intellij.debugger.PositionManagerFactory lives in the Java plugin, and the
         language layer has to keep loading in IDEs without one. The module is therefore NOT
         loading="required" – if the Java plugin is absent it is skipped and the rest of the plugin
         still works. -->
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="flix.jetbrains.plugin.language"/>
        <plugin id="com.intellij.java"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Makes the *stock* Java line breakpoint accept .flix lines. Without it,
             JavaLineBreakpointTypeBase.canPutAtElement refuses the file outright and the position
             manager below is never consulted, because nothing asks it to resolve anything. -->
        <debugger.javaDebugAware
                implementation="dev.wstein.flixplugin.debugger.FlixJavaDebugAware"/>

        <debugger.positionManagerFactory
                implementation="dev.wstein.flixplugin.debugger.FlixPositionManagerFactory"/>

        <!-- Where a step may stop, which the position manager has no say in. Flix's CPS output puts
             one source line in each continuation frame and none at all in the generated invoke()
             bridges, so Java's "run until the line changes in this frame" always ends on frame pop,
             in bytecode with no source. This carries the step on to the next Flix line. Scoped to
             Flix's own frames, so Java, Kotlin and Scala stepping is untouched. -->
        <debugger.extraSteppingFilter
                implementation="dev.wstein.flixplugin.debugger.FlixSteppingFilter"/>
    </extensions>
</idea-plugin>
