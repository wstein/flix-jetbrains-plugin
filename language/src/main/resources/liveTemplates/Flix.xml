<templateSet group="Flix">
    <!-- Declaration scaffolding, and deliberately nothing else.
         The language server already completes expressions as snippets, `main` and a default effect
         handler among them, and MagicMatchCompleter expands `x.match` into one case per constructor
         of x's enum, which no template can do because it does not know the enum. Declarations are
         the gap: KeywordCompleter offers `def`, `enum`, `trait`, `instance`, `mod`, `struct` and
         `eff` as bare keywords with no shape after them. A template for something the server already
         snippets would offer one construct twice, from two inventories that drift.

         Every expansion here parses on its own, checked by FlixLiveTemplateSyntaxTest against this
         plugin's own parser. That is not only about shipping correct syntax: a template that left a
         body empty would leave the buffer unparseable from the moment it expanded until the user
         finished typing, and the language server reports that state as errors. Bodies therefore
         default to `???`, Flix's hole, which is valid and is what the user types over.

         Note the comment style: an XML comment may not contain two consecutive hyphens. One here
         once made the entire plugin fail to load while every build check passed. -->

    <template name="def" value="def $NAME$($PARAMS$): $TYPE$ = $BODY$"
              description="Flix function declaration" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;f&quot;" alwaysStopAt="true"/>
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Unit&quot;" alwaysStopAt="true"/>
        <variable name="BODY" expression="" defaultValue="&quot;???&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="pdef" value="pub def $NAME$($PARAMS$): $TYPE$ = $BODY$"
              description="Flix public function declaration" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;f&quot;" alwaysStopAt="true"/>
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Unit&quot;" alwaysStopAt="true"/>
        <variable name="BODY" expression="" defaultValue="&quot;???&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="mod" value="mod $NAME$ {&#10;    $BODY$&#10;}"
              description="Flix module" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;M&quot;" alwaysStopAt="true"/>
        <variable name="BODY" expression="" defaultValue="&quot;def f(): Unit = ???&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="enum" value="enum $NAME$ {&#10;    case $CASE$&#10;}"
              description="Flix enum" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;E&quot;" alwaysStopAt="true"/>
        <variable name="CASE" expression="" defaultValue="&quot;C&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="struct" value="struct $NAME$[$REGION$] {&#10;    $FIELD$: $TYPE$&#10;}"
              description="Flix struct" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;S&quot;" alwaysStopAt="true"/>
        <variable name="REGION" expression="" defaultValue="&quot;r&quot;" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="&quot;x&quot;" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Int32&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="trait" value="trait $NAME$[$TV$] {&#10;    pub def $OP$(x: $TV$): $TYPE$&#10;}"
              description="Flix trait" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;T&quot;" alwaysStopAt="true"/>
        <variable name="TV" expression="" defaultValue="&quot;a&quot;" alwaysStopAt="true"/>
        <variable name="OP" expression="" defaultValue="&quot;op&quot;" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Unit&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="instance" value="instance $TRAIT$[$TYPE$] {&#10;    $BODY$&#10;}"
              description="Flix trait instance" toReformat="false" toShortenFQNames="false">
        <variable name="TRAIT" expression="" defaultValue="&quot;T&quot;" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Int32&quot;" alwaysStopAt="true"/>
        <variable name="BODY" expression="" defaultValue="&quot;pub def op(x: Int32): Unit = ???&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="eff" value="eff $NAME$ {&#10;    def $OP$($PARAMS$): $TYPE$&#10;}"
              description="Flix effect" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;E&quot;" alwaysStopAt="true"/>
        <variable name="OP" expression="" defaultValue="&quot;op&quot;" alwaysStopAt="true"/>
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="&quot;Unit&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>

    <template name="test" value="@Test&#10;def $NAME$(): Bool = $BODY$"
              description="Flix test" toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="&quot;test01&quot;" alwaysStopAt="true"/>
        <variable name="BODY" expression="" defaultValue="&quot;true&quot;" alwaysStopAt="true"/>
        <context><option name="Flix" value="true"/></context>
    </template>
</templateSet>
